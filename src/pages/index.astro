---
import { Picture, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import BestSellerCard from '../components/BestSellerCard.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import ContactBlock from '../components/ContactBlock.astro';
import MapEmbed from '../components/MapEmbed.astro';
import '@fontsource/caveat/600.css';

// Diego's photography (July 2026)
import heroBowl from '../assets/images/hero-bowl.png'; // cutout chicken bowl, transparent bg
import muralImage from '../assets/images/mural.png'; // shop wall mural, used as a faint hero wash
import jfcImage from '../assets/images/chicken-bowl.jpg';
import salmonImage from '../assets/images/salmon-bowl.jpg';
import prawnsImage from '../assets/images/prawns-bowl.jpg';
import cateringImage from '../assets/images/bowl-in-hand.jpg';

// Optimised URL for the mural, handed to CSS as a custom property below.
const mural = await getImage({ src: muralImage, format: 'webp', width: 1600 });
---

<Layout
  title="Ichiban Pokedon | Japanese Poke Bowls & Donburi in Tauranga"
  description="Fresh Japanese poke bowls and donburi made daily at The Historic Village, Tauranga. Dine in, takeaway and catering for weddings, corporate and private events."
>
  <!-- Hero — split layout over a faint wash of the shop's wall mural -->
  <section class="hero" style={`--mural-url: url(${mural.src})`}>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>
          <span class="hero-brand">Ichiban</span>
          <span class="hero-script">Fresh Japanese</span>
          <span class="hero-main">Poke &amp; Donburi</span>
        </h1>
        <div class="hero-rule" aria-hidden="true"></div>
        <p class="hero-sub">
          Fresh ingredients.<br />Fast service.<br />Dine in, takeaway and catering.
        </p>
        <div class="hero-buttons">
          <a href="/menu" class="btn btn-accent">View Menu</a>
          <a href="/catering" class="btn btn-accent-outline">Catering</a>
        </div>
      </div>
      <div class="hero-media">
        <Picture
          src={heroBowl}
          formats={['avif', 'webp']}
          alt="Japanese fried chicken bowl with avocado from Ichiban Pokedon"
          loading="eager"
          fetchpriority="high"
          widths={[480, 760, 1181]}
          sizes="(max-width: 900px) 82vw, 620px"
        />
      </div>
    </div>
  </section>

  <!-- Best Sellers -->
  <Section
    id="best-sellers"
    eyebrow="Best Sellers"
    heading="The bowls everyone comes back for"
  >
    <div class="bestseller-grid">
      <BestSellerCard
        image={jfcImage}
        imageAlt="Japanese Fried Chicken bowl"
        name="Japanese Fried Chicken"
        description="Crispy, juicy karaage chicken over fresh rice"
        price="From $19"
        badge="Most Popular"
      />
      <BestSellerCard
        image={salmonImage}
        imageAlt="Salmon poke bowl"
        name="Salmon"
        description="Fresh marinated salmon with vibrant toppings"
        price="From $21"
        imagePosition="50% 82%"
      />
      <BestSellerCard
        image={prawnsImage}
        imageAlt="Crispy prawns bowl"
        name="Crispy Prawns"
        description="Lightly battered prawns with a golden crunch"
        price="From $19"
      />
    </div>
    <div class="bestseller-cta fade-in">
      <a href="/menu" class="btn btn-outline">See the full menu</a>
    </div>
  </Section>

  <!-- About -->
  <Section id="about" eyebrow="About Ichiban" narrow>
    <p class="about-copy fade-in">
      ICHIBAN serves fresh Japanese poke and donburi bowls made daily using quality ingredients
      and bold flavours. Whether you're grabbing lunch or catering your next event, we focus on
      fresh food, generous portions and fast service.
    </p>
  </Section>

  <!-- Google Reviews -->
  <ReviewsSection />

  <!-- Catering preview -->
  <section class="section" id="catering-preview">
    <div class="container">
      <div class="catering-preview fade-in">
        <div class="catering-media">
          <Picture
            src={cateringImage}
            formats={['avif', 'webp']}
            alt="A guest holding a fresh Ichiban chicken bowl at an outdoor event"
            loading="lazy"
            widths={[640, 960, 1098]}
            sizes="(max-width: 900px) 92vw, 560px"
          />
        </div>
        <div class="catering-copy">
          <span class="eyebrow">Catering</span>
          <h2>Bring Ichiban to your next event</h2>
          <p class="lede">
            From weddings and corporate functions to festivals and private parties — our food
            truck and catering team serve fresh Japanese bowls your guests will remember.
          </p>
          <a href="/catering" class="btn btn-primary">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visit Us -->
  <Section id="visit" eyebrow="Visit Us" heading="Find us at The Historic Village" warm>
    <div class="visit-grid fade-in">
      <MapEmbed />
      <ContactBlock />
    </div>
  </Section>
</Layout>

<style>
  /* --- Hero: split layout, cutout bowl right, mural wash behind --- */
  .hero {
    position: relative;
    background: var(--color-hero-wash);
    overflow: hidden;
  }

  /* The shop's wall mural, dialled right back so it reads as texture only. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--mural-url);
    background-size: cover;
    background-position: center;
    opacity: 0.12;
    pointer-events: none;
  }

  .hero-inner {
    position: relative; /* above the mural wash */
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    min-height: min(78vh, 720px);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .hero-brand {
    display: block;
    text-transform: uppercase;
    font-size: clamp(1.05rem, 2vw, 1.45rem);
    letter-spacing: 0.18em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .hero-script {
    display: block;
    font-family: 'Caveat', cursive;
    font-weight: 600;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    color: var(--color-accent-strong);
    line-height: 1;
    margin-bottom: 0.4rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .hero-main {
    display: block;
  }

  .hero-copy h1 {
    text-transform: uppercase;
    font-size: clamp(2.75rem, 6.5vw, 4.75rem);
    letter-spacing: -0.02em;
    line-height: 1.02;
  }

  .hero-rule {
    width: 64px;
    height: 4px;
    border-radius: 2px;
    background: var(--color-accent);
    margin-block: 1.4rem;
  }

  .hero-sub {
    font-size: var(--text-lede);
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2.2rem;
  }

  .btn-accent {
    background: var(--color-accent-strong);
    color: var(--color-paper);
    border-color: var(--color-accent-strong);
  }

  .btn-accent:hover {
    background: #b25a22;
    border-color: #b25a22;
  }

  .btn-accent-outline {
    background: transparent;
    color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  .btn-accent-outline:hover {
    background: var(--color-accent-soft);
  }

  .hero-media {
    display: flex;
    justify-content: center;
  }

  .hero-media :global(img) {
    width: min(100%, 620px);
    height: auto;
    filter: drop-shadow(0 24px 48px rgba(17, 17, 20, 0.18));
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      min-height: 0;
    }

    .hero-rule {
      margin-inline: auto;
    }

    .hero-buttons {
      justify-content: center;
    }

    .hero-media {
      order: -1;
      padding-top: 1rem;
    }

    .hero-media :global(img) {
      width: min(78vw, 420px);
    }
  }

  /* --- Best sellers --- */
  .bestseller-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .bestseller-cta {
    text-align: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* --- About --- */
  #about :global(.section-intro) {
    margin-bottom: 1rem;
  }

  .about-copy {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.7;
    text-align: center;
    font-weight: 500;
  }

  /* --- Catering preview --- */
  .catering-preview {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .catering-media :global(img) {
    width: 100%;
    height: auto;
    /* Source is portrait; crop to landscape and hold the bowl in frame. */
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 38% 62%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
  }

  .catering-copy .lede {
    margin-block: 1rem 1.8rem;
  }

  /* --- Visit us --- */
  .visit-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .bestseller-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
      margin-inline: auto;
    }

    .catering-preview,
    .visit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
