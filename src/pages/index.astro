---
import { Picture, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import BestSellerCard from '../components/BestSellerCard.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import ContactBlock from '../components/ContactBlock.astro';
import MapEmbed from '../components/MapEmbed.astro';

// PLACEHOLDER IMAGES — swap for Diego's Dropbox shots when they arrive:
//   heroImage      → Japanese Fried Chicken Bowl hero shot (~2400×1600)
//   jfcImage       → JFC bowl square (~1200×1200)
//   salmonImage    → Salmon bowl square (~1200×1200)
//   prawnsImage    → Crispy Prawns bowl square (~1200×1200) — no real photo exists yet
//   cateringImage  → food truck at an event (~1600×1000)
import heroImage from '../assets/images/hero.jpg';
import jfcImage from '../assets/images/poke-bowl.jpg';
import salmonImage from '../assets/images/gallery-2.jpg';
import prawnsImage from '../assets/images/gallery-4.jpg';
import cateringImage from '../assets/images/catering.jpg';

// Preload the AVIF hero — matches the largest <source> below.
const heroPreload = await getImage({ src: heroImage, format: 'avif', width: 1920 });
---

<Layout
  title="Ichiban Pokedon | Japanese Poke Bowls & Donburi in Tauranga"
  description="Fresh Japanese poke bowls and donburi made daily at The Historic Village, Tauranga. Dine in, takeaway and catering for weddings, corporate and private events."
  preloadImage={heroPreload.src}
  preloadImageType="image/avif"
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        alt="Japanese fried chicken bowl from Ichiban Pokedon"
        class="hero-bg-image"
        loading="eager"
        widths={[640, 1024, 1920]}
        sizes="100vw"
        pictureAttributes={{ class: 'hero-bg-picture' }}
      />
    </div>
    <div class="hero-content">
      <h1>Fresh Japanese Poke &amp; Donburi</h1>
      <p class="hero-sub">Fresh ingredients. Fast service. Dine in, takeaway and catering.</p>
      <div class="hero-buttons">
        <a href="/menu" class="btn btn-light">View Menu</a>
        <a href="/catering" class="btn btn-ghost">Catering</a>
      </div>
    </div>
  </section>

  <!-- Best Sellers -->
  <Section
    id="best-sellers"
    eyebrow="Best Sellers"
    heading="The bowls everyone comes back for"
  >
    <div class="bestseller-grid">
      <BestSellerCard
        image={jfcImage}
        imageAlt="Japanese Fried Chicken bowl"
        name="Japanese Fried Chicken"
        description="Crispy, juicy karaage chicken over fresh rice"
        price="From $18"
        badge="Most Popular"
      />
      <BestSellerCard
        image={salmonImage}
        imageAlt="Salmon poke bowl"
        name="Salmon"
        description="Fresh marinated salmon with vibrant toppings"
        price="From $18"
      />
      <BestSellerCard
        image={prawnsImage}
        imageAlt="Crispy prawns bowl"
        name="Crispy Prawns"
        description="Lightly battered prawns with a golden crunch"
        price="From $18"
      />
    </div>
    <div class="bestseller-cta fade-in">
      <a href="/menu" class="btn btn-outline">See the full menu</a>
    </div>
  </Section>

  <!-- About -->
  <Section id="about" eyebrow="About Ichiban" narrow>
    <p class="about-copy fade-in">
      ICHIBAN serves fresh Japanese poke and donburi bowls made daily using quality ingredients
      and bold flavours. Whether you're grabbing lunch or catering your next event, we focus on
      fresh food, generous portions and fast service.
    </p>
  </Section>

  <!-- Google Reviews -->
  <ReviewsSection />

  <!-- Catering preview -->
  <section class="section" id="catering-preview">
    <div class="container">
      <div class="catering-preview fade-in">
        <div class="catering-media">
          <Picture
            src={cateringImage}
            formats={['avif', 'webp']}
            alt="The Ichiban food truck serving at an event"
            loading="lazy"
            widths={[640, 960, 1280]}
            sizes="(max-width: 900px) 92vw, 560px"
          />
        </div>
        <div class="catering-copy">
          <span class="eyebrow">Catering</span>
          <h2>Bring Ichiban to your next event</h2>
          <p class="lede">
            From weddings and corporate functions to festivals and private parties — our food
            truck and catering team serve fresh Japanese bowls your guests will remember.
          </p>
          <a href="/catering" class="btn btn-primary">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visit Us -->
  <Section id="visit" eyebrow="Visit Us" heading="Find us at The Historic Village" warm>
    <div class="visit-grid fade-in">
      <MapEmbed />
      <ContactBlock />
    </div>
  </Section>
</Layout>

<style>
  /* --- Hero --- */
  .hero {
    position: relative;
    min-height: min(88vh, 820px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-paper);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
  }

  /* <Picture> wraps the <img> in a <picture>; collapse it so positioning works. */
  .hero-bg :global(.hero-bg-picture) {
    display: contents;
  }

  .hero-bg :global(.hero-bg-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(17, 17, 20, 0.35), rgba(17, 17, 20, 0.55));
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: var(--gutter);
    max-width: 780px;
  }

  .hero-sub {
    font-size: var(--text-lede);
    margin-top: 1.1rem;
    opacity: 0.92;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2.2rem;
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-paper);
    border-color: var(--color-paper);
  }

  .btn-ghost:hover {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  /* --- Best sellers --- */
  .bestseller-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .bestseller-cta {
    text-align: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* --- About --- */
  #about :global(.section-intro) {
    margin-bottom: 1rem;
  }

  .about-copy {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.7;
    text-align: center;
    font-weight: 500;
  }

  /* --- Catering preview --- */
  .catering-preview {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .catering-media :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
  }

  .catering-copy .lede {
    margin-block: 1rem 1.8rem;
  }

  /* --- Visit us --- */
  .visit-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .bestseller-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
      margin-inline: auto;
    }

    .catering-preview,
    .visit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
