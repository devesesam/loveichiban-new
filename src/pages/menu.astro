---
import Layout from '../layouts/Layout.astro';
import MenuCategory from '../components/MenuCategory.astro';
import { MENU } from '../data/menu';
---

<Layout
  title="Menu | Poke Bowls & Donburi in Tauranga | Ichiban Pokedon"
  description="Fresh poke bowls and donburi in Tauranga — Japanese fried chicken, salmon, prawns, calamari, tuna and tofu, plus breakfast, sides and extras."
>
  <div class="menu-page">
    <div class="container container-narrow">
      <header class="menu-header fade-in">
        <span class="eyebrow">Our Menu</span>
        <h1>Poke bowls &amp; donburi, made fresh daily</h1>
        <nav class="menu-jump" aria-label="Menu categories">
          {MENU.map((category) => <a href={`#${category.id}`}>{category.title}</a>)}
        </nav>
      </header>

      {MENU.map((category) => <MenuCategory category={category} />)}
    </div>
  </div>
</Layout>

<style>
  .menu-page {
    padding-block: clamp(3rem, 7vw, 5rem) var(--section-pad);
  }

  .menu-header {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .menu-jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .menu-jump a {
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.45rem 1.1rem;
    border: 1.5px solid var(--color-line);
    border-radius: 999px;
    transition: border-color var(--transition), background var(--transition),
      color var(--transition);
  }

  .menu-jump a:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
</style>
