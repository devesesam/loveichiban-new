---
// Google Reviews trust section. Reads src/data/reviews.json, which is either the
// committed fallback or freshly written by scripts/fetch-reviews.mjs at build time.
// While the JSON is still the placeholder, renders an honest "read us on Google"
// block instead of fake data.
import Section from './Section.astro';
import reviewsData from '../data/reviews.json';

interface Review {
  author: string;
  rating: number;
  text: string;
  relativeTime: string;
}

const { placeholder, rating, userRatingCount } = reviewsData as {
  placeholder?: boolean;
  rating: number | null;
  userRatingCount: number | null;
  reviews: Review[];
};

const reviews: Review[] = (reviewsData.reviews as Review[]) ?? [];
const hasData = !placeholder && rating != null && reviews.length > 0;

const GOOGLE_REVIEWS_URL =
  'https://www.google.com/maps/search/?api=1&query=Ichiban+The+Historic+Village+Tauranga';

function stars(n: number): string {
  return '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));
}
---

<Section id="reviews" eyebrow="Reviews" heading="What our customers say" warm>
  {
    hasData ? (
      <div class="reviews">
        <div class="reviews-summary fade-in">
          <span class="reviews-rating">{rating?.toFixed(1)}</span>
          <span class="reviews-stars" aria-hidden="true">
            {stars(rating ?? 0)}
          </span>
          <span class="reviews-count">{userRatingCount} Google reviews</span>
        </div>
        <div class="reviews-carousel">
          <button class="reviews-arrow" id="reviewsPrev" aria-label="Previous review" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 4.5 8 12l7.5 7.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
          <div class="reviews-track" id="reviewsTrack" tabindex="0" aria-label="Customer reviews carousel">
            {reviews.map((review) => (
              <blockquote class="review-card">
                <span class="review-stars" aria-label={`${review.rating} out of 5 stars`}>
                  {stars(review.rating)}
                </span>
                <p>{review.text}</p>
                <footer>
                  <cite>{review.author}</cite>
                  <span class="review-time">{review.relativeTime}</span>
                </footer>
              </blockquote>
            ))}
          </div>
          <button class="reviews-arrow" id="reviewsNext" aria-label="Next review" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4.5 16 12l-7.5 7.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
        </div>
        <div class="reviews-dots" id="reviewsDots" aria-hidden="true" />
        <p class="reviews-attribution">
          Reviews from Google ·{' '}
          <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener noreferrer">
            Read all our reviews on Google
          </a>
        </p>
      </div>
    ) : (
      <div class="reviews-fallback fade-in">
        <p class="lede">
          Our customers love us on Google — see what they're saying about their favourite bowls.
        </p>
        <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          Read our reviews on Google
        </a>
      </div>
    )
  }
</Section>

<style>
  .reviews-summary {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.25rem;
    flex-wrap: wrap;
  }

  .reviews-rating {
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .reviews-stars,
  .review-stars {
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .reviews-stars {
    font-size: 1.3rem;
  }

  .reviews-count {
    color: var(--color-ink-soft);
    font-weight: 600;
  }

  .reviews-carousel {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .reviews-arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--color-line);
    background: var(--color-paper);
    color: var(--color-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition), color var(--transition),
      background var(--transition);
  }

  .reviews-arrow svg {
    width: 18px;
    height: 18px;
  }

  .reviews-arrow:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  @media (max-width: 640px) {
    /* On touch screens the track itself swipes; arrows just eat width */
    .reviews-arrow {
      display: none;
    }
  }

  .reviews-track {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(420px, 86%);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
    scrollbar-width: none;
  }

  .reviews-track::-webkit-scrollbar {
    display: none;
  }

  .review-card {
    scroll-snap-align: center;
    background: var(--color-paper);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .review-card p {
    color: var(--color-ink-soft);
    flex: 1;
  }

  .review-card footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .review-card cite {
    font-style: normal;
    font-weight: 600;
  }

  .review-time {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .reviews-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .reviews-dots :global(button) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: var(--color-line);
    padding: 0;
    transition: background var(--transition), transform var(--transition);
  }

  .reviews-dots :global(button.active) {
    background: var(--color-accent-strong);
    transform: scale(1.25);
  }

  .reviews-attribution {
    text-align: center;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .reviews-attribution a {
    color: var(--color-accent-strong);
    font-weight: 600;
  }

  .reviews-fallback {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1.75rem;
    max-width: 560px;
    margin-inline: auto;
  }
</style>

<script>
  // Arrows, dot indicators and gentle auto-advance for the reviews carousel.
  // All movement scrolls ONLY the horizontal track (track.scrollTo) — never
  // scrollIntoView, which would also scroll the page itself to the section.
  const track = document.getElementById('reviewsTrack');
  const dots = document.getElementById('reviewsDots');
  const prevBtn = document.getElementById('reviewsPrev');
  const nextBtn = document.getElementById('reviewsNext');

  if (track && dots) {
    const cards = Array.from(track.children) as HTMLElement[];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const goTo = (i: number) => {
      const card = cards[(i + cards.length) % cards.length];
      track.scrollTo({
        left: card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    };

    cards.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.addEventListener('click', () => goTo(i));
      dots.appendChild(dot);
    });

    const dotButtons = Array.from(dots.children) as HTMLButtonElement[];

    const activeIndex = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let nearest = 0;
      let nearestDist = Infinity;
      cards.forEach((card, i) => {
        const dist = Math.abs(card.offsetLeft + card.offsetWidth / 2 - center);
        if (dist < nearestDist) {
          nearestDist = dist;
          nearest = i;
        }
      });
      return nearest;
    };

    const setActive = () => {
      const nearest = activeIndex();
      dotButtons.forEach((d, i) => d.classList.toggle('active', i === nearest));
      return nearest;
    };

    track.addEventListener('scroll', setActive, { passive: true });
    setActive();

    prevBtn?.addEventListener('click', () => goTo(activeIndex() - 1));
    nextBtn?.addEventListener('click', () => goTo(activeIndex() + 1));

    if (!reduceMotion && cards.length > 1) {
      let paused = false;
      let inView = false;

      track.addEventListener('pointerenter', () => (paused = true));
      track.addEventListener('pointerleave', () => (paused = false));
      track.addEventListener('focusin', () => (paused = true));
      track.addEventListener('focusout', () => (paused = false));

      // Only auto-advance while the carousel is actually on screen.
      new IntersectionObserver(
        (entries) => {
          inView = entries[0]?.isIntersecting ?? false;
        },
        { threshold: 0.3 }
      ).observe(track);

      setInterval(() => {
        if (paused || !inView || document.hidden) return;
        goTo(activeIndex() + 1);
      }, 6000);
    }
  }
</script>
