---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { SITE } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header" id="header">
  <nav class="nav" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label="Ichiban Pokedon home">
      <Image src={logo} alt="Ichiban Pokedon logo" width={104} height={104} densities={[1, 2]} />
    </a>
    <div class="nav-links">
      {
        SITE.nav.map((item) => (
          <a href={item.href} class:list={{ active: currentPath === item.href }}>
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="nav-cta">
      <a href={SITE.phoneHref} class="nav-phone">{SITE.phone}</a>
      <a href="/catering" class="btn btn-primary">Catering</a>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileMenu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>
</header>
