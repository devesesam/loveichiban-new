---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { SITE, formatAddress } from '../data/site';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <a href="/" class="footer-logo" aria-label="Ichiban Pokedon home">
        <Image src={logo} alt="Ichiban Pokedon logo" width={128} height={128} densities={[1, 2]} />
      </a>
      <div class="footer-cols">
        <div class="footer-col">
          <h4>Explore</h4>
          <ul>
            {SITE.nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4>Find Us</h4>
          <ul>
            <li>
              <a href={SITE.mapsLink} target="_blank" rel="noopener noreferrer">
                {formatAddress()}
              </a>
            </li>
            <li><a href={SITE.phoneHref}>{SITE.phone}</a></li>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Hours</h4>
          <ul>
            {
              SITE.hours.length > 0 ? (
                SITE.hours.map((h) => (
                  <li>
                    {h.days}: {h.open} – {h.close}
                  </li>
                ))
              ) : (
                <li>
                  <a href={SITE.phoneHref}>Call us for current hours</a>
                </li>
              )
            }
          </ul>
        </div>
        <div class="footer-col">
          <h4>Follow</h4>
          <SocialLinks />
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} {SITE.name}. All rights reserved.</p>
      <p>Fresh Japanese poke &amp; donburi — Tauranga, NZ</p>
    </div>
  </div>
</footer>
