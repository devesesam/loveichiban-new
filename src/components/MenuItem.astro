---
import type { MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;

const priceLabel = item.prices
  ? `Reg ${item.prices.regular} / Lge ${item.prices.large}`
  : item.price;
---

<div class="menu-item">
  <div class="menu-item-head">
    <h3>
      {item.name}
      {item.badge && <span class="menu-badge">⭐ {item.badge}</span>}
      {item.dietary?.map((d) => <span class="menu-dietary">{d}</span>)}
    </h3>
    {priceLabel && <span class="menu-price">{priceLabel}</span>}
  </div>
  {item.description && <p class="menu-desc">{item.description}</p>}
</div>

<style>
  .menu-item {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .menu-item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .menu-item-head h3 {
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .menu-price {
    font-weight: 600;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .menu-desc {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    margin-top: 0.25rem;
    max-width: 52ch;
  }

  .menu-badge {
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .menu-dietary {
    font-size: 0.7rem;
    font-weight: 600;
    border: 1.5px solid var(--color-accent);
    color: var(--color-accent-strong);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
  }
</style>
