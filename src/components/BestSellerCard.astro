---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  name: string;
  description?: string;
  price?: string;
  badge?: string;
}

const { image, imageAlt, name, description, price, badge } = Astro.props;
---

<article class="bestseller fade-in">
  <div class="bestseller-media">
    <Picture
      src={image}
      formats={['avif', 'webp']}
      alt={imageAlt}
      loading="lazy"
      widths={[480, 720, 960]}
      sizes="(max-width: 720px) 92vw, 380px"
    />
    {badge && <span class="bestseller-badge">⭐ {badge}</span>}
  </div>
  <div class="bestseller-body">
    <h3>{name}</h3>
    {description && <p>{description}</p>}
    {price && <span class="bestseller-price">{price}</span>}
  </div>
</article>

<style>
  .bestseller {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-paper);
    box-shadow: var(--shadow-soft);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .bestseller:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .bestseller-media {
    position: relative;
  }

  .bestseller-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .bestseller-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    box-shadow: var(--shadow-soft);
  }

  .bestseller-body {
    padding: 1.4rem 1.5rem 1.6rem;
    display: grid;
    gap: 0.35rem;
  }

  .bestseller-body p {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }

  .bestseller-price {
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-top: 0.3rem;
  }
</style>
